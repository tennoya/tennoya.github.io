rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validPhoto(value) {
      return value is string
        && value.size() <= 150000
        && value.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }
    match /posts/{postId} {
      allow get, list: if isAdmin() || resource.data.status == 'approved';
      allow create: if request.resource.data.keys().hasOnly(['name','message','images','createdAt','status'])
        && request.resource.data.keys().hasAll(['name','message','createdAt','status'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && (!('images' in request.resource.data) || (
          request.resource.data.images is list
          && request.resource.data.images.size() <= 3
          && (request.resource.data.images.size() < 1 || validPhoto(request.resource.data.images[0]))
          && (request.resource.data.images.size() < 2 || validPhoto(request.resource.data.images[1]))
          && (request.resource.data.images.size() < 3 || validPhoto(request.resource.data.images[2]))
        ))
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
      match /reactions/{reactionId} {
        allow get, list: if get(/databases/$(database)/documents/posts/$(postId)).data.status == 'approved';
        allow create: if get(/databases/$(database)/documents/posts/$(postId)).data.status == 'approved'
          && reactionId.matches('b[0-9a-f]{32}_(like|heart)')
          && request.resource.data.keys().hasOnly(['type','createdAt'])
          && request.resource.data.keys().hasAll(['type','createdAt'])
          && request.resource.data.type in ['like','heart']
          && reactionId.matches('b[0-9a-f]{32}_' + request.resource.data.type)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if true;
      }
    }
    match /replies/{replyId} {
      allow get, list: if isAdmin() || resource.data.status == 'approved';
      allow create: if request.resource.data.keys().hasOnly(['postId','parentId','name','message','createdAt','status'])
        && request.resource.data.keys().hasAll(['postId','parentId','name','message','createdAt','status'])
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.status == 'approved'
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, write: if false;
    }
    match /siteStats/visits {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
  }
}
